{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "network-monitor",
  "version": "0.1.0",
  "identifier": "com.networkmonitor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Windows Network Monitor",
        "url": "index.html",
        "width": 1050,
        "height": 700,
        "minWidth": 880,
        "minHeight": 580,
        "center": true
      },
      {
        "label": "widget",
        "title": "NetPulse Taskbar Speed Meter",
        "url": "index.html?widget=true",
        "width": 125,
        "height": 40,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "visible": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
